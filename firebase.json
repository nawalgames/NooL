{
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      "database.rules.json",
      ".firebaserc",
      "README.md",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      { "source": "/fd/diff", "destination": "/games/spot-diff/index.html" },
      { "source": "/fd/mazafa", "destination": "/games/mazafa/index.html" },
      { "source": "/fd/harb", "destination": "/games/harb/index.html" }
    ]
  },
  "database": {
    "rules": "database.rules.json"
  }
}
